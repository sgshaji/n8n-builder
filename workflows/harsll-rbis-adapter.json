    {
      "id": "3599f1ae-bdca-4e65-a618-1c3133716a41",
      "name": "Tidy the request",
      "notes": "Picks out the four inputs (operation, rbisBaseUrl, ref, params), works out the RBIS call for a write, and refuses a request it cannot carry out: an unknown operation, no account reference, no RBIS address, or endLiability without the names of the people whose liability should end.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "onError": "continueErrorOutput",
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b3a28ac9-fb8f-433b-9924-2a1d088fb9e3",
              "name": "operation",
              "value": "={{ String($json.operation ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "3d15b73c-e9c1-42ff-9153-386f8c27235c",
              "name": "ref",
              "value": "={{ String($json.ref ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "3094528c-d6e8-44a4-a66d-39c25b3f18e2",
              "name": "baseUrl",
              "value": "={{ String($json.rbisBaseUrl ?? '').trim().replace(/\\/+$/, '') }}",
              "type": "string"
            },
            {
              "id": "a05f5857-8912-4677-9eec-da0c192fcf96",
              "name": "params",
              "value": "={{ $json.params && typeof $json.params === 'object' && !Array.isArray($json.params) ? $json.params : ({}) }}",
              "type": "object"
            },
            {
              "id": "4d92c293-595d-4c31-b055-ea8973824da5",
              "name": "readPath",
              "value": "={{ String($json.operation ?? '').trim() === 'canTerminate' ? '/termination-options' : '' }}",
              "type": "string"
            },
            {
              "id": "c8e09d05-7765-41b7-a3b6-f2b4a37abf61",
              "name": "write",
              "value": "={{ ({\n  endLiability: { method: 'POST', path: '/terminate', body: { endDate: $json.params?.endDate ?? null } },\n  addLiableParty: { method: 'POST', path: '/liable-parties', body: { name: $json.params?.name ?? null, type: $json.params?.type ?? null, startDate: $json.params?.startDate ?? null } },\n  createDetail: { method: 'POST', path: '/details', body: { startDate: $json.params?.startDate ?? null, tenants: $json.params?.tenants ?? null } },\n  setContactDetails: { method: 'PUT', path: '/contact', body: { name: $json.params?.name ?? null, email: $json.params?.email || null, phone: $json.params?.phone || null } },\n  setForwardingAddress: { method: 'PUT', path: '/forwarding-address', body: { address: $json.params?.address ?? null } }\n})[String($json.operation ?? '').trim()] ?? ({ method: 'GET', path: '', body: null }) }}",
              "type": "object"
            },
            {
              "id": "e214540c-ee9e-42c4-9926-a73b146a3098",
              "name": "requestError",
              "value": "={{ !['findAccount','getAccount','canTerminate','endLiability','addLiableParty','createDetail','setContactDetails','setForwardingAddress'].includes(String($json.operation ?? '').trim()) ? 'UNKNOWN_OPERATION'\n  : !String($json.ref ?? '').trim() ? 'MISSING_REF'\n  : !/^https?:\\/\\/\\S+$/.test(String($json.rbisBaseUrl ?? '').trim()) ? 'MISSING_RBIS_BASE_URL'\n  : (String($json.operation ?? '').trim() === 'endLiability' && !(Array.isArray($json.params?.parties) && $json.params.parties.length > 0)) ? 'INVALID_PARAMS'\n  : '' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
