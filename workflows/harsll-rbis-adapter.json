    {
      "id": "5b66cca5-908c-4a38-91bb-bfe971a72e90",
      "name": "Read the account from RBIS",
      "notes": "Every operation reads first: the account, or for canTerminate its termination options. 'Never error' is on, so RBIS's own answers (404, 409, 503) come out of the success output and are sorted below. Only a failure to reach RBIS at all (refused, unknown host, timeout) goes to the error output.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [
        780,
        0
      ],
      "parameters": {
        "url": "={{ $json.baseUrl }}/accounts/{{ encodeURIComponent($json.ref) }}{{ $json.readPath }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
