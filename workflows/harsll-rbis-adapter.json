    {
      "id": "466b0321-2a38-4fa4-8ac1-93471a8eb416",
      "name": "Answer: read failed",
      "notes": "RBIS answered the read with something other than 200. For findAccount, 404 ACCOUNT_NOT_FOUND is a normal answer: found = false, reason NOT_FOUND. Otherwise: 5xx, 408 and 429 are transient (try again later); any other answer is a business error with RBIS's own code.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "onError": "continueErrorOutput",
      "position": [
        1300,
        380
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({\n  ok: $('Tidy the request').item.json.operation === 'findAccount' && $json.statusCode === 404 && $json.body?.error === 'ACCOUNT_NOT_FOUND',\n  operation: $('Tidy the request').item.json.operation,\n  ref: $('Tidy the request').item.json.ref,\n  alreadyDone: false,\n  data: $('Tidy the request').item.json.operation === 'findAccount' && $json.statusCode === 404 && $json.body?.error === 'ACCOUNT_NOT_FOUND' ? { found: false, reason: 'NOT_FOUND', account: null } : null,\n  error: $('Tidy the request').item.json.operation === 'findAccount' && $json.statusCode === 404 && $json.body?.error === 'ACCOUNT_NOT_FOUND' ? null : { code: $json.body?.error ?? ('HTTP_' + $json.statusCode), message: $json.body?.message ?? $json.statusMessage ?? '', httpStatus: $json.statusCode, transient: $json.statusCode >= 500 || [408, 429].includes($json.statusCode) }\n}) }}",
        "includeOtherFields": false,
        "options": {}
      }
    },
