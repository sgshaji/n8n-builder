# ------------------------------------------------------------------
# Local settings for the n8n-builder Docker stack.
#
# 1. Copy this file to .env       (.env is ignored by Git)
# 2. Fill in N8N_ENCRYPTION_KEY   (see docs/setup/01-run-n8n-locally.md)
# Never commit .env.
# ------------------------------------------------------------------

# n8n version. Pinned so everyone runs the same version.
# Upgrade deliberately: see "Upgrading n8n" in the setup guide.
N8N_VERSION=2.48.5

# Port for the n8n editor: http://localhost:5678
N8N_PORT=5678

# Time zone used for schedules and dates.
TIMEZONE=Europe/London

# Encrypts the credentials n8n stores (passwords, API keys).
# Generate once, keep it safe, and never change it: changing it makes
# saved credentials unreadable. Required.
N8N_ENCRYPTION_KEY=

# Test mailbox (Mailpit). Web view: http://localhost:8025
MAILPIT_VERSION=v1.34.0
MAILPIT_UI_PORT=8025

# Pretend RBIS (made-up accounts, for building and testing). http://localhost:8088
# n8n workflows reach it at http://mock-rbis:8080, whatever port is set here.
MOCK_RBIS_PORT=8088
MOCK_RBIS_NODE_VERSION=22-alpine

# ------------------------------------------------------------------
# n8n API: used by the set-up script, the sample run and the tests
# (docs/setup/01-run-n8n-locally.md, step 5)
# ------------------------------------------------------------------

# Create in n8n: Settings > n8n API > Create an API key. Required.
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# ------------------------------------------------------------------
# Optional developer tooling. Leave as it is if you don't use it.
# ------------------------------------------------------------------

N8N_MCP_TOKEN=
N8N_MCP_VERSION=2.103.1
