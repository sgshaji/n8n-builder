<mxfile host="app.diagrams.net" agent="n8n-builder" version="24.0.0">
  <diagram id="harsll-workflow-purposes" name="What each workflow does">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1060" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;HARSLL: what each workflow does&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="800" height="36" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Six n8n workflows. The Dispatcher and Performer match the two UiPath robots; the other four each do one job for them." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1100" height="28" as="geometry" /></mxCell>
        <mxCell id="dispatcher" value="HARSLL – Dispatcher" style="swimlane;html=1;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#1F3A5F;strokeColor=#1F3A5F;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="370" height="400" as="geometry" /></mxCell>
        <mxCell id="dispatcher-body" value="&lt;div style=&quot;font-size:13px;color:#212121;margin-bottom:8px&quot;&gt;&lt;b&gt;Runs the whole job, from start to finish.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:6px&quot;&gt;&lt;b&gt;Starts when:&lt;/b&gt; A spreadsheet lands in the input folder (after about a minute), every 15 minutes, or “Run now” (testing only).&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:2px&quot;&gt;&lt;b&gt;What it does:&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:0 0 8px 0;padding-left:16px;font-size:12px;color:#263238;line-height:1.35&quot;&gt;&lt;li&gt;Takes the lock, so only one run works at a time&lt;/li&gt;&lt;li&gt;Loads the settings&lt;/li&gt;&lt;li&gt;Hands each new spreadsheet to &lt;i&gt;take in a file&lt;/i&gt;&lt;/li&gt;&lt;li&gt;Runs the Performer for every unfinished case, oldest date first&lt;/li&gt;&lt;li&gt;Hands each finished spreadsheet to &lt;i&gt;report a batch&lt;/i&gt;&lt;/li&gt;&lt;li&gt;Releases the lock&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;overflow=hidden;" vertex="1" parent="dispatcher"><mxGeometry y="44" width="370" height="312" as="geometry" /></mxCell>
        <mxCell id="dispatcher-uipath" value="&lt;b&gt;In UiPath:&lt;/b&gt; The Dispatcher robot, plus Orchestrator’s scheduling" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#455A64;fillColor=#F5F7F9;strokeColor=none;" vertex="1" parent="dispatcher"><mxGeometry y="356" width="370" height="42" as="geometry" /></mxCell>
        <mxCell id="takein" value="Dispatcher: take in a file" style="swimlane;html=1;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#1565C0;strokeColor=#1565C0;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="370" height="400" as="geometry" /></mxCell>
        <mxCell id="takein-body" value="&lt;div style=&quot;font-size:13px;color:#212121;margin-bottom:8px&quot;&gt;&lt;b&gt;Turns one spreadsheet into cases.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:6px&quot;&gt;&lt;b&gt;Starts when:&lt;/b&gt; Called by the Dispatcher, once for each new spreadsheet.&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:2px&quot;&gt;&lt;b&gt;What it does:&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:0 0 8px 0;padding-left:16px;font-size:12px;color:#263238;line-height:1.35&quot;&gt;&lt;li&gt;Checks the file name is safe and the columns are right&lt;/li&gt;&lt;li&gt;Tidies text and dates&lt;/li&gt;&lt;li&gt;Links rows for the same tenancy (joint tenants)&lt;/li&gt;&lt;li&gt;Records one case per new row; skips rows already done, re-opens referred ones&lt;/li&gt;&lt;li&gt;Archives the file, or rejects it and emails the team&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;overflow=hidden;" vertex="1" parent="takein"><mxGeometry y="44" width="370" height="312" as="geometry" /></mxCell>
        <mxCell id="takein-uipath" value="&lt;b&gt;In UiPath:&lt;/b&gt; The Dispatcher robot reading the file and filling the queue" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#455A64;fillColor=#F5F7F9;strokeColor=none;" vertex="1" parent="takein"><mxGeometry y="356" width="370" height="42" as="geometry" /></mxCell>
        <mxCell id="report" value="Dispatcher: report a batch" style="swimlane;html=1;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#1565C0;strokeColor=#1565C0;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="370" height="400" as="geometry" /></mxCell>
        <mxCell id="report-body" value="&lt;div style=&quot;font-size:13px;color:#212121;margin-bottom:8px&quot;&gt;&lt;b&gt;Tells people what happened to a spreadsheet.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:6px&quot;&gt;&lt;b&gt;Starts when:&lt;/b&gt; Called by the Dispatcher, once for each spreadsheet waiting for its summary.&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:2px&quot;&gt;&lt;b&gt;What it does:&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:0 0 8px 0;padding-left:16px;font-size:12px;color:#263238;line-height:1.35&quot;&gt;&lt;li&gt;Waits until every case from that spreadsheet is finished&lt;/li&gt;&lt;li&gt;Writes the staff worklist, urgent cases first&lt;/li&gt;&lt;li&gt;Sends a summary email with counts only, no names&lt;/li&gt;&lt;li&gt;Marks the spreadsheet as reported&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;overflow=hidden;" vertex="1" parent="report"><mxGeometry y="44" width="370" height="312" as="geometry" /></mxCell>
        <mxCell id="report-uipath" value="&lt;b&gt;In UiPath:&lt;/b&gt; Not shown in the flowchart" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#455A64;fillColor=#F5F7F9;strokeColor=none;" vertex="1" parent="report"><mxGeometry y="356" width="370" height="42" as="geometry" /></mxCell>
        <mxCell id="performer" value="HARSLL – Performer" style="swimlane;html=1;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#2E7D32;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="370" height="400" as="geometry" /></mxCell>
        <mxCell id="performer-body" value="&lt;div style=&quot;font-size:13px;color:#212121;margin-bottom:8px&quot;&gt;&lt;b&gt;Decides and acts on one case.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:6px&quot;&gt;&lt;b&gt;Starts when:&lt;/b&gt; Called by the Dispatcher, once for each case.&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:2px&quot;&gt;&lt;b&gt;What it does:&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:0 0 8px 0;padding-left:16px;font-size:12px;color:#263238;line-height:1.35&quot;&gt;&lt;li&gt;Claims the case, so no other run can take it&lt;/li&gt;&lt;li&gt;Runs the five safety checks&lt;/li&gt;&lt;li&gt;All pass: updates RBIS through the adapter&lt;/li&gt;&lt;li&gt;Any fails: leaves RBIS alone and refers the case to staff, with the reason&lt;/li&gt;&lt;li&gt;A technical failure is retried up to 3 times, carrying on where it stopped&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;overflow=hidden;" vertex="1" parent="performer"><mxGeometry y="44" width="370" height="312" as="geometry" /></mxCell>
        <mxCell id="performer-uipath" value="&lt;b&gt;In UiPath:&lt;/b&gt; The Performer robot" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#455A64;fillColor=#F5F7F9;strokeColor=none;" vertex="1" parent="performer"><mxGeometry y="356" width="370" height="42" as="geometry" /></mxCell>
        <mxCell id="adapter" value="Performer: RBIS adapter" style="swimlane;html=1;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#6A1B9A;strokeColor=#6A1B9A;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="440" y="540" width="370" height="400" as="geometry" /></mxCell>
        <mxCell id="adapter-body" value="&lt;div style=&quot;font-size:13px;color:#212121;margin-bottom:8px&quot;&gt;&lt;b&gt;The only workflow that talks to RBIS.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:6px&quot;&gt;&lt;b&gt;Starts when:&lt;/b&gt; Called by the Performer, once for each RBIS step.&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:2px&quot;&gt;&lt;b&gt;What it does:&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:0 0 8px 0;padding-left:16px;font-size:12px;color:#263238;line-height:1.35&quot;&gt;&lt;li&gt;Looks up: finds the account, who is liable, whether liability can be ended&lt;/li&gt;&lt;li&gt;Changes: ends liability, adds a liable person, creates the detail record, saves contact details or a forwarding address&lt;/li&gt;&lt;li&gt;Looks before every change, so nothing is done twice&lt;/li&gt;&lt;li&gt;Today it talks to the pretend RBIS&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;font-size:12px;color:#6A1B9A;margin-bottom:6px&quot;&gt;&lt;b&gt;Moving to the real RBIS means replacing this one workflow.&lt;/b&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;overflow=hidden;" vertex="1" parent="adapter"><mxGeometry y="44" width="370" height="312" as="geometry" /></mxCell>
        <mxCell id="adapter-uipath" value="&lt;b&gt;In UiPath:&lt;/b&gt; The RBIS screen steps inside the Performer robot" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#455A64;fillColor=#F5F7F9;strokeColor=none;" vertex="1" parent="adapter"><mxGeometry y="356" width="370" height="42" as="geometry" /></mxCell>
        <mxCell id="settings" value="HARSLL – Settings" style="swimlane;html=1;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#616161;strokeColor=#616161;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1"><mxGeometry x="840" y="540" width="370" height="400" as="geometry" /></mxCell>
        <mxCell id="settings-body" value="&lt;div style=&quot;font-size:13px;color:#212121;margin-bottom:8px&quot;&gt;&lt;b&gt;One place for every adjustable value.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:6px&quot;&gt;&lt;b&gt;Starts when:&lt;/b&gt; Called by the Dispatcher, once per run.&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#546E7A;margin-bottom:2px&quot;&gt;&lt;b&gt;What it does:&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;margin:0 0 8px 0;padding-left:16px;font-size:12px;color:#263238;line-height:1.35&quot;&gt;&lt;li&gt;Business rules not yet confirmed: deaths, joint tenants, landlord dates&lt;/li&gt;&lt;li&gt;The spreadsheet’s expected columns&lt;/li&gt;&lt;li&gt;Folders and email addresses&lt;/li&gt;&lt;li&gt;Retry and timing limits&lt;/li&gt;&lt;li&gt;Where the tables and other workflows are (filled in by the set-up script)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=8;overflow=hidden;" vertex="1" parent="settings"><mxGeometry y="44" width="370" height="312" as="geometry" /></mxCell>
        <mxCell id="settings-uipath" value="&lt;b&gt;In UiPath:&lt;/b&gt; “Get Assets” and the robot’s config file" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#455A64;fillColor=#F5F7F9;strokeColor=none;" vertex="1" parent="settings"><mxGeometry y="356" width="370" height="42" as="geometry" /></mxCell>
        <mxCell id="tables" value="&lt;b&gt;Where HARSLL keeps its records&lt;/b&gt; (n8n data tables): &lt;b&gt;cases&lt;/b&gt;, one per spreadsheet row with its status and reason · &lt;b&gt;batches&lt;/b&gt;, one per spreadsheet · &lt;b&gt;lock&lt;/b&gt;, so only one run works at a time" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=12;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1170" height="46" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
